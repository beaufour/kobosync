# udev rule to auto-run kobosync when a Kobo eReader is plugged in.
#
# Install on Raspberry Pi / Linux:
#   sudo cp 99-kobo-sync.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#
# Adjust RUN= path to wherever kobosync is installed in your virtualenv.
# The ATTRS{idVendor} is the Kobo USB vendor ID (2237).
#
# Logs are written to /home/pi/kobosync.log.
# View live: tail -f /home/pi/kobosync.log
# Or via systemd journal: journalctl -u kobosync-trigger

ACTION=="add", SUBSYSTEM=="usb", ATTRS{idVendor}=="2237", \
    RUN+="/bin/systemd-run --unit=kobosync-trigger --uid=<username> \
      --property=StandardOutput=append:/home/<username>/kobosync.log \
      --property=StandardError=append:/home/<username>/kobosync.log \
      /home/<username>/.local/bin/kobosync sync --config /home/<username>/.config/kobosync/config.toml --eject"
